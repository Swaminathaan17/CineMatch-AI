# Copy this file to .env, or rely on process env vars / Replit Secrets.
# Config auto-locates backend/.env (or ./.env), and real env vars always win.
#
# Dropping a key here enables live TMDB search, AI Discovery, and per-movie
# detail/review fetching. Without it the system still works, it just degrades
# gracefully (local-only search, no live TMDB data).
TMDB_API_KEY=your_tmdb_api_key_here

# SQLAlchemy database URL. Defaults to a local SQLite file in the working dir.
DATABASE_URL=sqlite:///./movie_rec.db

# Region used for TMDB watch/streaming provider data on movie detail pages.
# Uses ISO-3166-1 alpha-2 country codes (e.g. US, GB, IN, DE).
TMDB_WATCH_PROVIDER_REGION=US

# Throttle (seconds) between TMDB requests made by ml_training/backfill_assets.py.
# Conservative default ~4 requests/second; raise the number to slow down, lower
# it only if you know TMDB's current rate limits.
TMDB_BACKFILL_DELAY_SECONDS=0.25
